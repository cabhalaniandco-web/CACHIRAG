;;=============================================================================
;;  GSTR-2B Reconciliation  ->  "Available Only on Portal"
;;  Custom right-panel (button bar) buttons for TallyPrime
;;
;;    Button 1 :  Import Configuration        (Alt+C)   -> Purchase Config screen
;;    Button 2 :  Import Selected Vouchers     (Alt+V)
;;
;;  Purchase ledgers are rate-wise (3/5/12/18/28%); GST ledgers are single
;;  (CGST / SGST / IGST / CESS).
;;
;;  Language : Tally Definition Language (TDL)   |   Product : TallyPrime
;;
;;  LOAD: F1 (Help) > TDL & Add-On > F4 (Manage Local TDLs) >
;;        "Load selected TDL files on startup" = Yes > add this file > restart.
;;=============================================================================


;;=============================================================================
;;  STEP 1 - Attach the two buttons to the GSTR-2B "Available Only on Portal"
;;  voucher list. Form 'GSTR Recon DrillDown' confirmed via Developer Mode.
;;=============================================================================

[#Form: GSTR Recon DrillDown]
    Add : Button : GSTR2B ImpConfig Btn
    Add : Button : GSTR2B ImpSelVch Btn


;;=============================================================================
;;  STEP 2 - Button definitions
;;=============================================================================

[Button: GSTR2B ImpConfig Btn]
    Key    : Alt+C
    Title  : "Import Configuration"
    Action : Display : GSTR2B Import Config

[Button: GSTR2B ImpSelVch Btn]
    Key    : Alt+V
    Title  : "Import Selected Vouchers"
    Action : Call : GSTR2B Import Selected Vouchers


;;=============================================================================
;;  STEP 3 - Configuration variables (each needs a [Variable:] description).
;;=============================================================================

;; -- Voucher types + GST toggle --
[Variable: GSTR2BImpVchType]
    Type : String
    Default : "Purchase"
[Variable: GSTR2BImpDrNoteVT]
    Type : String
    Default : ""
[Variable: GSTR2BImpCrNoteVT]
    Type : String
    Default : ""
[Variable: GSTR2BImpGSTPerWise]
    Type : Logical
    Default : No

;; -- Purchase ledgers (rate-wise) --
[Variable: GSTR2BImpExemptLed]
    Type : String
    Default : "PURCHASE EXEMPT"
[Variable: GSTR2BImpPurc3]
    Type : String
    Default : "PURCHASE 3%"
[Variable: GSTR2BImpPurc5]
    Type : String
    Default : "PURCHASE 5%"
[Variable: GSTR2BImpPurc12]
    Type : String
    Default : "PURCHASE 12%"
[Variable: GSTR2BImpPurc18]
    Type : String
    Default : "PURCHASE 18%"
[Variable: GSTR2BImpPurc28]
    Type : String
    Default : "PURCHASE 28%"

;; -- GST ledgers (single, not rate-wise) --
[Variable: GSTR2BImpCGST]
    Type : String
    Default : ""
[Variable: GSTR2BImpSGST]
    Type : String
    Default : ""
[Variable: GSTR2BImpIGST]
    Type : String
    Default : ""
[Variable: GSTR2BImpCessLed]
    Type : String
    Default : ""

;; -- Round Off --
[Variable: GSTR2BImpUseRoundOff]
    Type : Logical
    Default : No
[Variable: GSTR2BImpRoundOffLed]
    Type : String
    Default : ""


;;=============================================================================
;;  STEP 3B - Filtered dropdown sources (Collections + Formulas)
;;=============================================================================

[System: Formula]
    GSTR2BIsPurcVT : $Parent = "Purchase" OR $Name = "Purchase"
    GSTR2BIsDrVT   : $Parent = "Debit Note" OR $Name = "Debit Note"
    GSTR2BIsCrVT   : $Parent = "Credit Note" OR $Name = "Credit Note"

;; ---- Voucher-type dropdowns (Fetch Name so the table has a display value) ----
[Collection: GSTR2B PurcVchTypes]
    Type   : VoucherType
    Fetch  : Name
    Filter : GSTR2BIsPurcVT

[Collection: GSTR2B DrNoteVchTypes]
    Type   : VoucherType
    Fetch  : Name
    Filter : GSTR2BIsDrVT

[Collection: GSTR2B CrNoteVchTypes]
    Type   : VoucherType
    Fetch  : Name
    Filter : GSTR2BIsCrVT

;; ---- Ledger group sources (Belongs To : Yes includes sub-groups) ----
[Collection: GSTR2B Led PurcAcct]
    Type       : Ledger
    Child Of   : "Purchase Accounts"
    Belongs To : Yes
    Fetch      : Name
[Collection: GSTR2B Led DirExp]
    Type       : Ledger
    Child Of   : "Direct Expenses"
    Belongs To : Yes
    Fetch      : Name
[Collection: GSTR2B Led IndExp]
    Type       : Ledger
    Child Of   : "Indirect Expenses"
    Belongs To : Yes
    Fetch      : Name
[Collection: GSTR2B Led IndInc]
    Type       : Ledger
    Child Of   : "Indirect Incomes"
    Belongs To : Yes
    Fetch      : Name

;; Purchase ledger dropdown = Purchase Accounts + Direct Exp + Indirect Exp
[Collection: GSTR2B PurcLedgers]
    Collection : GSTR2B Led PurcAcct, GSTR2B Led DirExp, GSTR2B Led IndExp

;; GST / CESS ledger dropdown = Duties & Taxes
[Collection: GSTR2B DutiesLedgers]
    Type       : Ledger
    Child Of   : "Duties & Taxes"
    Belongs To : Yes
    Fetch      : Name

;; Round-off ledger dropdown = Indirect Expenses + Indirect Incomes
[Collection: GSTR2B RoundOffLedgers]
    Collection : GSTR2B Led IndExp, GSTR2B Led IndInc


;;=============================================================================
;;  STEP 4 - "Import Configuration" (Purchase Config) screen. Ctrl+A to save.
;;=============================================================================

[Report: GSTR2B Import Config]
    Form  : GSTR2B Import Config
    Title : "GSTR-2B Purchase Configuration"

[Form: GSTR2B Import Config]
    Parts  : GSTR2B Import Config
    Width  : 55% Screen
    Height : 70% Screen
    Local  : Field : Default : Border : Thin Box

[Part: GSTR2B Import Config]
    Lines  : GSTR2B H VchTypes, GSTR2B L VchType, GSTR2B L DrNote, GSTR2B L CrNote, GSTR2B L PerWise, GSTR2B H Ledgers, GSTR2B L Exempt, GSTR2B L Purc3, GSTR2B L Purc5, GSTR2B L Purc12, GSTR2B L Purc18, GSTR2B L Purc28, GSTR2B H GST, GSTR2B L CGST, GSTR2B L SGST, GSTR2B L IGST, GSTR2B L Cess, GSTR2B H Other, GSTR2B L UseRoundOff, GSTR2B L RoundOffLed
    Scroll : Vertical

;; ---- label fields ----
[Field: GSTR2B Cfg Prompt]
    Set as : ""
    Width  : 28
    Skip   : Yes

[Field: GSTR2B Cfg Head]
    Set as : ""
    Width  : 40
    Skip   : Yes
    Style  : Normal Bold

;; =================== Voucher Types ===================
[Line: GSTR2B H VchTypes]
    Fields : GSTR2B Cfg Head
    Local  : Field : GSTR2B Cfg Head : Set as : "Voucher Types"

[Line: GSTR2B L VchType]
    Fields : GSTR2B Cfg Prompt, GSTR2B F VchType
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Purchase Voucher Type"
[Field: GSTR2B F VchType]
    Use : Name Field
    Table : GSTR2B PurcVchTypes
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpVchType
    Set as : ##GSTR2BImpVchType

[Line: GSTR2B L DrNote]
    Fields : GSTR2B Cfg Prompt, GSTR2B F DrNote
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Dr. Note Voucher Type"
[Field: GSTR2B F DrNote]
    Use : Name Field
    Table : GSTR2B DrNoteVchTypes
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpDrNoteVT
    Set as : ##GSTR2BImpDrNoteVT

[Line: GSTR2B L CrNote]
    Fields : GSTR2B Cfg Prompt, GSTR2B F CrNote
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Cr. Note Voucher Type"
[Field: GSTR2B F CrNote]
    Use : Name Field
    Table : GSTR2B CrNoteVchTypes
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpCrNoteVT
    Set as : ##GSTR2BImpCrNoteVT

[Line: GSTR2B L PerWise]
    Fields : GSTR2B Cfg Prompt, GSTR2B F PerWise
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Enable GST Tax Entry Percent Wise"
[Field: GSTR2B F PerWise]
    Use : Logical Field
    Width : 30
    Modifies : GSTR2BImpGSTPerWise
    Set as : ##GSTR2BImpGSTPerWise

;; =================== Purchase Ledgers (rate-wise) ===================
[Line: GSTR2B H Ledgers]
    Fields : GSTR2B Cfg Head
    Local  : Field : GSTR2B Cfg Head : Set as : "Purchase Ledgers"

[Line: GSTR2B L Exempt]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Exempt
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Purchase Exempted Ledger"
[Field: GSTR2B F Exempt]
    Use : Name Field
    Table : GSTR2B PurcLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpExemptLed
    Set as : ##GSTR2BImpExemptLed

[Line: GSTR2B L Purc3]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Purc3
    Local  : Field : GSTR2B Cfg Prompt : Set as : "GST Purchase 3%"
[Field: GSTR2B F Purc3]
    Use : Name Field
    Table : GSTR2B PurcLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpPurc3
    Set as : ##GSTR2BImpPurc3

[Line: GSTR2B L Purc5]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Purc5
    Local  : Field : GSTR2B Cfg Prompt : Set as : "GST Purchase 5%"
[Field: GSTR2B F Purc5]
    Use : Name Field
    Table : GSTR2B PurcLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpPurc5
    Set as : ##GSTR2BImpPurc5

[Line: GSTR2B L Purc12]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Purc12
    Local  : Field : GSTR2B Cfg Prompt : Set as : "GST Purchase 12%"
[Field: GSTR2B F Purc12]
    Use : Name Field
    Table : GSTR2B PurcLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpPurc12
    Set as : ##GSTR2BImpPurc12

[Line: GSTR2B L Purc18]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Purc18
    Local  : Field : GSTR2B Cfg Prompt : Set as : "GST Purchase 18%"
[Field: GSTR2B F Purc18]
    Use : Name Field
    Table : GSTR2B PurcLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpPurc18
    Set as : ##GSTR2BImpPurc18

[Line: GSTR2B L Purc28]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Purc28
    Local  : Field : GSTR2B Cfg Prompt : Set as : "GST Purchase 28%"
[Field: GSTR2B F Purc28]
    Use : Name Field
    Table : GSTR2B PurcLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpPurc28
    Set as : ##GSTR2BImpPurc28

;; =================== GST Ledgers (single) ===================
[Line: GSTR2B H GST]
    Fields : GSTR2B Cfg Head
    Local  : Field : GSTR2B Cfg Head : Set as : "GST Ledgers"

[Line: GSTR2B L CGST]
    Fields : GSTR2B Cfg Prompt, GSTR2B F CGST
    Local  : Field : GSTR2B Cfg Prompt : Set as : "CGST Ledger"
[Field: GSTR2B F CGST]
    Use : Name Field
    Table : GSTR2B DutiesLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpCGST
    Set as : ##GSTR2BImpCGST

[Line: GSTR2B L SGST]
    Fields : GSTR2B Cfg Prompt, GSTR2B F SGST
    Local  : Field : GSTR2B Cfg Prompt : Set as : "SGST Ledger"
[Field: GSTR2B F SGST]
    Use : Name Field
    Table : GSTR2B DutiesLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpSGST
    Set as : ##GSTR2BImpSGST

[Line: GSTR2B L IGST]
    Fields : GSTR2B Cfg Prompt, GSTR2B F IGST
    Local  : Field : GSTR2B Cfg Prompt : Set as : "IGST Ledger"
[Field: GSTR2B F IGST]
    Use : Name Field
    Table : GSTR2B DutiesLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpIGST
    Set as : ##GSTR2BImpIGST

[Line: GSTR2B L Cess]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Cess
    Local  : Field : GSTR2B Cfg Prompt : Set as : "CESS Ledger"
[Field: GSTR2B F Cess]
    Use : Name Field
    Table : GSTR2B DutiesLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpCessLed
    Set as : ##GSTR2BImpCessLed

;; =================== Other ===================
[Line: GSTR2B H Other]
    Fields : GSTR2B Cfg Head
    Local  : Field : GSTR2B Cfg Head : Set as : "Other"

[Line: GSTR2B L UseRoundOff]
    Fields : GSTR2B Cfg Prompt, GSTR2B F UseRO
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Use Round Off"
[Field: GSTR2B F UseRO]
    Use : Logical Field
    Width : 30
    Modifies : GSTR2BImpUseRoundOff
    Set as : ##GSTR2BImpUseRoundOff

[Line: GSTR2B L RoundOffLed]
    Fields : GSTR2B Cfg Prompt, GSTR2B F ROLed
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Round Off Ledger"
[Field: GSTR2B F ROLed]
    Use : Name Field
    Table : GSTR2B RoundOffLedgers
    Show Table : Always
    Width : 30
    Inactive : NOT ##GSTR2BImpUseRoundOff
    Modifies : GSTR2BImpRoundOffLed
    Set as : ##GSTR2BImpRoundOffLed


;;=============================================================================
;;  STEP 5 - "Import Selected Vouchers" action.
;;  Validates the row selection + configuration. Complete the TODO block to
;;  actually post vouchers (needs the drill-down row object field names).
;;=============================================================================

[Function: GSTR2B Import Selected Vouchers]

    Variable : SelCount : Number

    01 : SET : SelCount : $$SelectedLines

    05 : IF : ##SelCount = 0
    10 :    MSGBOX : "Import Selected Vouchers" : "No rows selected. In the 'Available Only on Portal' section, select one or more rows using the Spacebar, then click 'Import Selected Vouchers'."
    15 :    RETURN
    20 : ENDIF

    25 : IF : $$IsEmpty:##GSTR2BImpVchType
    30 :    MSGBOX : "Import Selected Vouchers" : "Please set the Purchase Voucher Type first via 'Import Configuration' (Alt+C)."
    35 :    RETURN
    40 : ENDIF

    ;; TODO - per-row voucher creation using the rate-wise purchase ledgers and
    ;; the single CGST/SGST/IGST ledgers configured above.
    90 : MSGBOX : "Import Selected Vouchers" : "Ready to import " + $$String:##SelCount + " selected voucher(s) using voucher type '" + ##GSTR2BImpVchType + "'."

    RETURN

;;=============================================================================
;;  End of file
;;=============================================================================
