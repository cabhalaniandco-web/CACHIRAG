    Set as : ##GSTR2BImpSGST3
[Line: GSTR2B L IGST3]
    Fields : GSTR2B Cfg Prompt, GSTR2B F IGST3
    Local  : Field : GSTR2B Cfg Prompt : Set as : "IGST 3% Ledger"
[Field: GSTR2B F IGST3]
    Use : Name Field
    Table : GSTR2B DutiesLedgers
    Show Table : Always
    Width : 30
    Inactive : NOT ##GSTR2BImpEnableGST
