;;=============================================================================
;;  GSTR-2B Reconciliation  ->  "Available only on Portal"
;;  Custom right-panel (button bar) buttons for TallyPrime
;;
;;    Button 1 :  Import Configuration        (Alt+C)
;;    Button 2 :  Import Selected Vouchers     (Alt+V)
;;
;;  Language : Tally Definition Language (TDL)   |   Product : TallyPrime
;;=============================================================================
;;
;;  >>> READ THIS FIRST - fixes error "T0008: Could not find the default TDL
;;      definition of Form: ..." <<<
;;
;;  TDL can attach a button to a report ONLY by modifying that report's real,
;;  existing FORM (the [#Form: <name>] syntax). If the name is not an existing
;;  form, Tally aborts with T0008. Tally does NOT publish these internal names
;;  and they change between releases, so you must read the name off YOUR build.
;;
;;  HOW TO GET THE EXACT FORM NAME (Developer Mode - 2 minutes):
;;    1. Close TallyPrime.
;;    2. Right-click the TallyPrime shortcut > Properties.
;;    3. In "Target", add a space then  /DevMode  at the end, e.g.
;;         "C:\Program Files\TallyPrime\tally.exe" /DevMode
;;    4. Apply > open TallyPrime.
;;    5. Go to: Gateway of Tally > Display More Reports > Statutory Reports >
;;       GST Reports > GSTR-2B Reconciliation, and open the
;;       "Available only on Portal" view.
;;    6. Move the mouse to an EMPTY area (NOT on a value/field). A tooltip shows
;;       the current Report/Form name. THAT is the name you need.
;;
;;  THEN:
;;    - Put that name into the [#Form: ...] line in "STEP 1" below, AND
;;    - remove the leading  ;;  from the three STEP-1 lines to activate them.
;;  Until you do that, STEP 1 stays commented out so this file loads with NO
;;  error (the buttons just won't appear yet).
;;
;;  HOW TO LOAD:
;;    F1 (Help) > TDL & Add-On > F4 (Manage Local TDLs) >
;;    "Load selected TDL files on startup" = Yes > add this file > restart.
;;=============================================================================


;;=============================================================================
;;  STEP 1 - Attach the two buttons to the GSTR-2B form.
;;  Replace  YOUR REAL FORM NAME HERE  with the name from Developer Mode, then
;;  delete the leading  ;;  on the three lines below.
;;=============================================================================

;; Form name confirmed via Developer Mode on the "Available Only on Portal"
;; voucher list (Gateway > ... > GSTR-2B Reconciliation > Available Only on
;; Portal). This DrillDown form is shared by the reconciliation voucher lists,
;; so the buttons appear on those drill-down screens.
[#Form: GSTR Recon DrillDown]
    Add : Button : GSTR2B ImpConfig Btn
    Add : Button : GSTR2B ImpSelVch Btn


;;=============================================================================
;;  STEP 2 - Button definitions (these are safe to define even before STEP 1
;;  is activated; an unattached button simply does nothing).
;;=============================================================================

[Button: GSTR2B ImpConfig Btn]
    Key    : Alt+C
    Title  : "Import Configuration"
    Action : Display : GSTR2B Import Config

[Button: GSTR2B ImpSelVch Btn]
    Key    : Alt+V
    Title  : "Import Selected Vouchers"
    Action : Call : GSTR2B Import Selected Vouchers


;;=============================================================================
;;  STEP 3 - Persistent configuration variables used by the importer.
;;=============================================================================

[System: Variable]
    GSTR2BImpVchType    : "Purchase"     ;; Voucher Type to create
    GSTR2BImpPurcLedger : ""             ;; Default purchase (expense) ledger
    GSTR2BImpAutoCreate : Yes            ;; Auto-create missing masters?


;;=============================================================================
;;  STEP 4 - "Import Configuration" screen (functional).
;;  Set the voucher type, default purchase ledger and auto-create flag.
;;  Press Ctrl+A to save.
;;=============================================================================

[Report: GSTR2B Import Config]
    Form : GSTR2B Import Config

[Form: GSTR2B Import Config]
    Parts      : GSTR2B Import Config
    Width      : 55% Screen
    Height     : 28% Screen
    Space Top  : 5
    Space Left : 8
    Title      : "GSTR-2B Import Configuration"
    Local      : Field : Default : Border : Thin Box

[Part: GSTR2B Import Config]
    Lines : GSTR2B Cfg VchType, GSTR2B Cfg Ledger, GSTR2B Cfg AutoCreate

[Line: GSTR2B Cfg VchType]
    Fields : GSTR2B Cfg Prompt, GSTR2B Cfg VchType Fld
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Purchase Voucher Type"

[Line: GSTR2B Cfg Ledger]
    Fields : GSTR2B Cfg Prompt, GSTR2B Cfg Ledger Fld
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Default Purchase Ledger"

[Line: GSTR2B Cfg AutoCreate]
    Fields : GSTR2B Cfg Prompt, GSTR2B Cfg AutoCreate Fld
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Auto-create missing masters"

[Field: GSTR2B Cfg Prompt]
    Set as : ""
    Width  : 28
    Skip   : Yes
    Style  : Normal Bold

[Field: GSTR2B Cfg VchType Fld]
    Use       : Name Field
    Table     : VoucherType
    Show Table: Always
    Modifies  : GSTR2BImpVchType
    Set as    : ##GSTR2BImpVchType

[Field: GSTR2B Cfg Ledger Fld]
    Use       : Name Field
    Table     : Ledger
    Show Table: Always
    Modifies  : GSTR2BImpPurcLedger
    Set as    : ##GSTR2BImpPurcLedger

[Field: GSTR2B Cfg AutoCreate Fld]
    Use      : Logical Field
    Modifies : GSTR2BImpAutoCreate
    Set as   : ##GSTR2BImpAutoCreate


;;=============================================================================
;;  STEP 5 - "Import Selected Vouchers" action.
;;  Validates the row selection + configuration, then (after you complete the
;;  creation block) writes one voucher per selected row.
;;=============================================================================

[Function: GSTR2B Import Selected Vouchers]

    Variable : SelCount : Number : 0

    ;; Number of rows marked with the Spacebar in the report.
    01 : SET : SelCount : $$SelectedLines

    05 : IF : ##SelCount = 0
    10 :    MSGBOX : "Import Selected Vouchers" : "No rows selected. In the 'Available only on Portal' section, select one or more rows using the Spacebar, then click 'Import Selected Vouchers'."
    15 :    RETURN
    20 : ENDIF

    25 : IF : $$IsEmpty:##GSTR2BImpPurcLedger
    30 :    MSGBOX : "Import Selected Vouchers" : "Please set the Default Purchase Ledger first via 'Import Configuration' (Alt+C)."
    35 :    RETURN
    40 : ENDIF

    ;;-------------------------------------------------------------------------
    ;; TODO - per-row voucher creation.
    ;; After confirming the GSTR-2B row field names in Developer Mode, iterate
    ;; the selected rows and create one voucher each, e.g.:
    ;;
    ;;   50 : NEW OBJECT   : Voucher
    ;;   55 :    SET VALUE : Date            : <source invoice date field>    ;; TODO
    ;;   60 :    SET VALUE : VoucherTypeName : ##GSTR2BImpVchType
    ;;   65 :    SET VALUE : PartyLedgerName : <source supplier field>        ;; TODO
    ;;   70 :    SET VALUE : Reference       : <source invoice-no field>      ;; TODO
    ;;   75 :    ;; add ledger allocations for taxable value + IGST/CGST/SGST  ;; TODO
    ;;   80 :    SAVE TARGET
    ;;   85 : END NEW OBJECT
    ;;-------------------------------------------------------------------------

    ;; Placeholder confirmation so you can verify the button + selection wiring.
    90 : MSGBOX : "Import Selected Vouchers" : "Ready to import " + $$String:##SelCount + " selected voucher(s) using ledger '" + ##GSTR2BImpPurcLedger + "' and voucher type '" + ##GSTR2BImpVchType + "'."

    RETURN

;;=============================================================================
;;  End of file
;;=============================================================================
