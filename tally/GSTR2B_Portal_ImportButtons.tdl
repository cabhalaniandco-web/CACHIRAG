;;=============================================================================
;;  GSTR-2B Reconciliation  ->  "Available Only on Portal"
;;  Custom right-panel (button bar) buttons for TallyPrime
;;
;;    Button 1 :  Import Configuration        (Alt+C)   -> Purchase Config screen
;;    Button 2 :  Import Selected Vouchers     (Alt+V)
;;
;;  Language : Tally Definition Language (TDL)   |   Product : TallyPrime
;;
;;  LOAD: F1 (Help) > TDL & Add-On > F4 (Manage Local TDLs) >
;;        "Load selected TDL files on startup" = Yes > add this file > restart.
;;=============================================================================


;;=============================================================================
;;  STEP 1 - Attach the two buttons to the GSTR-2B "Available Only on Portal"
;;  voucher list. Form 'GSTR Recon DrillDown' confirmed via Developer Mode.
;;=============================================================================

[#Form: GSTR Recon DrillDown]
    Add : Button : GSTR2B ImpConfig Btn
    Add : Button : GSTR2B ImpSelVch Btn


;;=============================================================================
;;  STEP 2 - Button definitions
;;=============================================================================

[Button: GSTR2B ImpConfig Btn]
    Key    : Alt+C
    Title  : "Import Configuration"
    Action : Display : GSTR2B Import Config

[Button: GSTR2B ImpSelVch Btn]
    Key    : Alt+V
    Title  : "Import Selected Vouchers"
    Action : Call : GSTR2B Import Selected Vouchers


;;=============================================================================
;;  STEP 3 - Configuration variables (each needs a [Variable:] description).
;;=============================================================================

;; -- Voucher types + GST toggle --
[Variable: GSTR2BImpVchType]
    Type : String
    Default : "Purchase"
[Variable: GSTR2BImpDrNoteVT]
    Type : String
    Default : ""
[Variable: GSTR2BImpCrNoteVT]
    Type : String
    Default : ""
[Variable: GSTR2BImpEnableGST]
    Type : Logical
    Default : Yes

;; -- Exempt / Cess / Round Off --
[Variable: GSTR2BImpExemptLed]
    Type : String
    Default : "PURCHASE EXEMPT"
[Variable: GSTR2BImpCessLed]
    Type : String
    Default : ""
[Variable: GSTR2BImpUseRoundOff]
    Type : Logical
    Default : No
[Variable: GSTR2BImpRoundOffLed]
    Type : String
    Default : ""

;; -- 3% --
[Variable: GSTR2BImpPurc3]
    Type : String
    Default : ""
[Variable: GSTR2BImpCGST3]
    Type : String
    Default : "INPUT CGST 1.5%"
[Variable: GSTR2BImpSGST3]
    Type : String
    Default : "INPUT SGST 1.5%"
[Variable: GSTR2BImpIGST3]
    Type : String
    Default : "INPUT IGST 3%"

;; -- 5% --
[Variable: GSTR2BImpPurc5]
    Type : String
    Default : ""
[Variable: GSTR2BImpCGST5]
    Type : String
    Default : "INPUT CGST 2.5%"
[Variable: GSTR2BImpSGST5]
    Type : String
    Default : "INPUT SGST 2.5%"
[Variable: GSTR2BImpIGST5]
    Type : String
    Default : "INPUT IGST 5%"

;; -- 12% --
[Variable: GSTR2BImpPurc12]
    Type : String
    Default : ""
[Variable: GSTR2BImpCGST12]
    Type : String
    Default : "INPUT CGST 6%"
[Variable: GSTR2BImpSGST12]
    Type : String
    Default : "INPUT SGST 6%"
[Variable: GSTR2BImpIGST12]
    Type : String
    Default : "INPUT IGST 12%"

;; -- 18% --
[Variable: GSTR2BImpPurc18]
    Type : String
    Default : ""
[Variable: GSTR2BImpCGST18]
    Type : String
    Default : "INPUT CGST 9%"
[Variable: GSTR2BImpSGST18]
    Type : String
    Default : "INPUT SGST 9%"
[Variable: GSTR2BImpIGST18]
    Type : String
    Default : "INPUT IGST 18%"

;; -- 28% --
[Variable: GSTR2BImpPurc28]
    Type : String
    Default : ""
[Variable: GSTR2BImpCGST28]
    Type : String
    Default : "INPUT CGST 14%"
[Variable: GSTR2BImpSGST28]
    Type : String
    Default : "INPUT SGST 14%"
[Variable: GSTR2BImpIGST28]
    Type : String
    Default : "INPUT IGST 28%"


;;=============================================================================
;;  STEP 3B - Filtered dropdown sources (Collections + Formulas)
;;  Voucher types by base type; ledgers by group (incl. sub-groups).
;;=============================================================================

[System: Formula]
    GSTR2BIsPurcVT : $Parent = "Purchase"
    GSTR2BIsDrVT   : $Parent = "Debit Note"
    GSTR2BIsCrVT   : $Parent = "Credit Note"

;; ---- Voucher-type dropdowns ----
[Collection: GSTR2B PurcVchTypes]
    Type   : VoucherType
    Filter : GSTR2BIsPurcVT

[Collection: GSTR2B DrNoteVchTypes]
    Type   : VoucherType
    Filter : GSTR2BIsDrVT

[Collection: GSTR2B CrNoteVchTypes]
    Type   : VoucherType
    Filter : GSTR2BIsCrVT

;; ---- Ledger group sources (Belongs To : Yes includes sub-groups) ----
[Collection: GSTR2B Led PurcAcct]
    Type       : Ledger
    Child Of   : "Purchase Accounts"
    Belongs To : Yes
[Collection: GSTR2B Led DirExp]
    Type       : Ledger
    Child Of   : "Direct Expenses"
    Belongs To : Yes
[Collection: GSTR2B Led IndExp]
    Type       : Ledger
    Child Of   : "Indirect Expenses"
    Belongs To : Yes
[Collection: GSTR2B Led IndInc]
    Type       : Ledger
    Child Of   : "Indirect Incomes"
    Belongs To : Yes

;; Purchase ledger dropdown = Purchase Accounts + Direct Exp + Indirect Exp
[Collection: GSTR2B PurcLedgers]
    Collection : GSTR2B Led PurcAcct, GSTR2B Led DirExp, GSTR2B Led IndExp

;; GST / CESS ledger dropdown = Duties & Taxes
[Collection: GSTR2B DutiesLedgers]
    Type       : Ledger
    Child Of   : "Duties & Taxes"
    Belongs To : Yes

;; Round-off ledger dropdown = Indirect Expenses + Indirect Incomes
[Collection: GSTR2B RoundOffLedgers]
    Collection : GSTR2B Led IndExp, GSTR2B Led IndInc


;;=============================================================================
;;  STEP 4 - "Import Configuration" (Purchase Config) screen. Ctrl+A to save.
;;=============================================================================

[Report: GSTR2B Import Config]
    Form  : GSTR2B Import Config
    Title : "GSTR-2B Purchase Configuration"

[Form: GSTR2B Import Config]
    Parts  : GSTR2B Import Config
    Width  : 60% Screen
    Height : 85% Screen
    Local  : Field : Default : Border : Thin Box

[Part: GSTR2B Import Config]
    Lines  : GSTR2B H VchTypes, GSTR2B L VchType, GSTR2B L DrNote, GSTR2B L CrNote, GSTR2B L EnableGST, GSTR2B H Ledgers, GSTR2B L Exempt, GSTR2B H R3, GSTR2B L Purc3, GSTR2B L CGST3, GSTR2B L SGST3, GSTR2B L IGST3, GSTR2B H R5, GSTR2B L Purc5, GSTR2B L CGST5, GSTR2B L SGST5, GSTR2B L IGST5, GSTR2B H R12, GSTR2B L Purc12, GSTR2B L CGST12, GSTR2B L SGST12, GSTR2B L IGST12, GSTR2B H R18, GSTR2B L Purc18, GSTR2B L CGST18, GSTR2B L SGST18, GSTR2B L IGST18, GSTR2B H R28, GSTR2B L Purc28, GSTR2B L CGST28, GSTR2B L SGST28, GSTR2B L IGST28, GSTR2B H Other, GSTR2B L Cess, GSTR2B L UseRoundOff, GSTR2B L RoundOffLed
    Scroll : Vertical

;; ---- label fields ----
[Field: GSTR2B Cfg Prompt]
    Set as : ""
    Width  : 26
    Skip   : Yes

[Field: GSTR2B Cfg Head]
    Set as : ""
    Width  : 40
    Skip   : Yes
    Style  : Normal Bold

;; =================== Voucher Types ===================
[Line: GSTR2B H VchTypes]
    Fields : GSTR2B Cfg Head
    Local  : Field : GSTR2B Cfg Head : Set as : "Voucher Types"

[Line: GSTR2B L VchType]
    Fields : GSTR2B Cfg Prompt, GSTR2B F VchType
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Purchase Voucher Type"
[Field: GSTR2B F VchType]
    Use : Name Field
    Table : GSTR2B PurcVchTypes
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpVchType
    Set as : ##GSTR2BImpVchType

[Line: GSTR2B L DrNote]
    Fields : GSTR2B Cfg Prompt, GSTR2B F DrNote
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Dr. Note Voucher Type"
[Field: GSTR2B F DrNote]
    Use : Name Field
    Table : GSTR2B DrNoteVchTypes
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpDrNoteVT
    Set as : ##GSTR2BImpDrNoteVT

[Line: GSTR2B L CrNote]
    Fields : GSTR2B Cfg Prompt, GSTR2B F CrNote
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Cr. Note Voucher Type"
[Field: GSTR2B F CrNote]
    Use : Name Field
    Table : GSTR2B CrNoteVchTypes
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpCrNoteVT
    Set as : ##GSTR2BImpCrNoteVT

[Line: GSTR2B L EnableGST]
    Fields : GSTR2B Cfg Prompt, GSTR2B F EnableGST
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Enable GST Tax Entry Per"
[Field: GSTR2B F EnableGST]
    Use : Logical Field
    Width : 30
    Modifies : GSTR2BImpEnableGST
    Set as : ##GSTR2BImpEnableGST

;; =================== Ledgers ===================
[Line: GSTR2B H Ledgers]
    Fields : GSTR2B Cfg Head
    Local  : Field : GSTR2B Cfg Head : Set as : "Ledgers"

[Line: GSTR2B L Exempt]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Exempt
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Purchase Exempted Ledger"
[Field: GSTR2B F Exempt]
    Use : Name Field
    Table : GSTR2B PurcLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpExemptLed
    Set as : ##GSTR2BImpExemptLed

;; =================== GST Purchase 3% ===================
[Line: GSTR2B H R3]
    Fields : GSTR2B Cfg Head
    Local  : Field : GSTR2B Cfg Head : Set as : "GST Purchase 3%"
[Line: GSTR2B L Purc3]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Purc3
    Local  : Field : GSTR2B Cfg Prompt : Set as : "Purchase 3% Ledger"
[Field: GSTR2B F Purc3]
    Use : Name Field
    Table : GSTR2B PurcLedgers
    Show Table : Always
    Width : 30
    Modifies : GSTR2BImpPurc3
    Set as : ##GSTR2BImpPurc3
[Line: GSTR2B L CGST3]
    Fields : GSTR2B Cfg Prompt, GSTR2B F CGST3
    Local  : Field : GSTR2B Cfg Prompt : Set as : "CGST 3% Ledger"
[Field: GSTR2B F CGST3]
    Use : Name Field
    Table : GSTR2B DutiesLedgers
    Show Table : Always
    Width : 30
    Inactive : NOT ##GSTR2BImpEnableGST
    Modifies : GSTR2BImpCGST3
    Set as : ##GSTR2BImpCGST3
[Line: GSTR2B L SGST3]
    Fields : GSTR2B Cfg Prompt, GSTR2B F SGST3
    Local  : Field : GSTR2B Cfg Prompt : Set as : "SGST 3% Ledger"
[Field: GSTR2B F SGST3]
