;;=============================================================================
;;  STEP 5 - "Import Selected Vouchers" action.
;;  Validates the row selection + configuration. Complete the TODO block to
;;  actually post vouchers (needs the drill-down row object field names).
;;=============================================================================

[Function: GSTR2B Import Selected Vouchers]

    Variable : SelCount : Number

    01 : SET : SelCount : $$SelectedLines

    05 : IF : ##SelCount = 0
    10 :    MSGBOX : "Import Selected Vouchers" : "No rows selected. In the 'Available Only on Portal' section, select one or more rows using the Spacebar, then click 'Import Selected Vouchers'."
    15 :    RETURN
    20 : ENDIF

    25 : IF : $$IsEmpty:##GSTR2BImpVchType
    30 :    MSGBOX : "Import Selected Vouchers" : "Please set the Purchase Voucher Type first via 'Import Configuration' (Alt+C)."
    35 :    RETURN
    40 : ENDIF

    ;; TODO - per-row voucher creation using the rate-wise ledgers configured above.
    90 : MSGBOX : "Import Selected Vouchers" : "Ready to import " + $$String:##SelCount + " selected voucher(s) using voucher type '" + ##GSTR2BImpVchType + "'."

    RETURN

;;=============================================================================
;;  End of file
;;=============================================================================
