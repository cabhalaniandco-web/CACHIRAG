    Set as : $GSTR2BIGSTUDF

[Line: GSTR2B L Cess]
    Fields : GSTR2B Cfg Prompt, GSTR2B F Cess
    Local  : Field : GSTR2B Cfg Prompt : Set as : "CESS Ledger"
[Field: GSTR2B F Cess]
